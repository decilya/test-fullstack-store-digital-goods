{
    "name": "gamerstore/backend",
    "description": "GamerStore - Магазин цифровых товаров для геймеров. Backend API на PHP 8.3",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    
    "autoload": {
        "psr-4": {
            "App\\": "backend/"
        },
        "files": [
            "backend/config/database.php",
            "backend/config/security.php",
            "backend/config/rate-limit.php"
        ]
    },
    
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "backend/tests/"
        }
    },
    
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:race": "php backend/tests/RaceConditionTest.php",
        "db:init": "php -r \"\n    $db = new PDO('sqlite:backend/database/store.db');\n    $db->exec(file_get_contents('backend/database/schema.sql'));\n    $db->exec(file_get_contents('backend/database/seed.sql'));\n    echo 'Database initialized successfully';\n\"",
        "db:migrate": "php -r \"\n    $db = new PDO('sqlite:backend/database/store.db');\n    $db->exec(file_get_contents('backend/database/schema.sql'));\n    echo 'Migrations applied';\n\"",
        "db:seed": "php -r \"\n    $db = new PDO('sqlite:backend/database/store.db');\n    $db->exec(file_get_contents('backend/database/seed.sql'));\n    echo 'Database seeded';\n\"",
        "db:reset": "php -r \"\n    if (file_exists('backend/database/store.db')) {\n        unlink('backend/database/store.db');\n    }\n    $db = new PDO('sqlite:backend/database/store.db');\n    $db->exec(file_get_contents('backend/database/schema.sql'));\n    $db->exec(file_get_contents('backend/database/seed.sql'));\n    echo 'Database reset and seeded';\n\"",
        "lint": "php -l backend/**/*.php",
        "start": "php -S localhost:8000 -t frontend",
        "docker:up": "docker-compose up -d --build",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "docker:shell": "docker-compose exec php bash"
    },
    
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    },
    
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}